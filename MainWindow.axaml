<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EtchForge.MainWindow"
        Title="EtchForge — 镜像格式转换"
        Width="1240" Height="780" MinWidth="1020" MinHeight="680"
        Background="#101827" Foreground="#F2F6FB">
  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#81A0B4" />
      <Setter Property="LetterSpacing" Value="1.3" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9AAABD" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1A2536" />
      <Setter Property="BorderBrush" Value="#2D3E51" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FC6A5D" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20,13" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#29384B" />
      <Setter Property="Foreground" Value="#F2F6FB" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,11" />
    </Style>
    <Style Selector="TextBox.readonly">
      <Setter Property="Background" Value="#111C2C" />
      <Setter Property="Foreground" Value="#B9CAD7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="32,28,32,24">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,26">
      <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
        <Border Width="46" Height="46" Background="#35D7C3" CornerRadius="13">
          <TextBlock Text="◆" Foreground="#10212C" FontSize="26" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="EtchForge" FontSize="25" FontWeight="Bold" />
          <TextBlock Text="把磁盘镜像带到你需要的平台" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="#1E3141" CornerRadius="999" Padding="14,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="8" Height="8" Background="#35D7C3" CornerRadius="4" VerticalAlignment="Center" />
          <TextBlock x:Name="EngineStatus" Text="检测转换引擎中…" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,20,*,20,*">
      <!-- Source -->
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="01  SOURCE" Classes="eyebrow" />
            <TextBlock Text="选择镜像" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="导入完整的 raw .img 磁盘镜像" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="ImportButton" Grid.Row="1" Classes="primary" Content="＋  选择 IMG 文件"
                  Click="Import_Click" HorizontalAlignment="Stretch" Margin="0,26,0,18" />
          <Border Grid.Row="2" Background="#122334" CornerRadius="12" Padding="14" MinHeight="70">
            <StackPanel Spacing="5">
              <TextBlock x:Name="SourceName" Text="尚未选择文件" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="SourceSummary" Text="镜像大小和分区结构将在这里显示" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="3" Spacing="11" Margin="0,23,0,0">
            <TextBlock Text="镜像指纹" Classes="eyebrow" />
            <TextBlock Text="SHA-256" Classes="muted" />
            <TextBox x:Name="ShaText" Classes="readonly" Text="等待导入" IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="MD5" Classes="muted" Margin="0,5,0,0" />
            <TextBox x:Name="Md5Text" Classes="readonly" Text="等待导入" IsReadOnly="True" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="4" Spacing="8">
            <TextBlock x:Name="ImportStatus" Text="准备就绪" Classes="muted" TextWrapping="Wrap" />
            <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Value="0" Height="5" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Connector -->
      <TextBlock Grid.Column="1" Text="›" Foreground="#35D7C3" FontSize="35"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Format and progress -->
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="02  FORMAT" Classes="eyebrow" />
            <TextBlock Text="选择格式" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="本地转换，不连接虚拟机平台" Classes="muted" />
          </StackPanel>
          <ComboBox x:Name="FormatPicker" Grid.Row="1" Margin="0,26,0,12" MinHeight="48"
                    SelectionChanged="Format_Changed" Background="#122334" Foreground="#F2F6FB">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F2F6FB" />
                  <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9AAABD" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Grid.Row="2" Spacing="12" Margin="0,12,0,0">
            <Border Background="#122334" CornerRadius="12" Padding="15">
              <StackPanel Spacing="7">
                <TextBlock Text="转换说明" Classes="eyebrow" />
                <TextBlock x:Name="FormatDescription" Text="请选择输出格式" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ConversionStatus" Text="等待开始" Classes="muted" TextWrapping="Wrap" />
            <ProgressBar x:Name="ConversionProgress" Minimum="0" Maximum="100" Value="0" Height="9" />
            <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="30" FontWeight="Bold" Foreground="#35D7C3" />
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="10">
            <Button x:Name="ConvertButton" Classes="primary" Content="开始转换  →" Click="Convert_Click"
                    HorizontalAlignment="Stretch" IsEnabled="False" />
            <Button x:Name="CancelButton" Classes="secondary" Content="取消转换" Click="Cancel_Click"
                    HorizontalAlignment="Stretch" IsVisible="False" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Column="3" Text="›" Foreground="#35D7C3" FontSize="35"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <!-- Destination -->
      <Border Grid.Column="4" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="03  DESTINATION" Classes="eyebrow" />
            <TextBlock Text="查看产物" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="选择输出目录并追踪文件位置" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Row="1" Classes="secondary" Content="⌁  选择输出文件夹" Click="Output_Click"
                  HorizontalAlignment="Stretch" Margin="0,26,0,18" />
          <Border Grid.Row="2" Background="#122334" CornerRadius="12" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="输出目录" Classes="eyebrow" />
              <TextBlock x:Name="OutputDirectoryText" Text="导入镜像后自动建议目录" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="3" Spacing="12" Margin="0,23,0,0">
            <TextBlock Text="预计产物" Classes="eyebrow" />
            <TextBox x:Name="OutputPreview" Classes="readonly" Text="等待选择镜像和格式"
                     IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="转换完成后显示全部实际生成文件。多分卷 VMDK 可能产生多个文件。"
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="OpenOutputButton" Grid.Row="4" Classes="secondary" Content="在文件管理器中打开  ↗"
                  Click="OpenOutput_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,22,0,0">
      <TextBlock Text="LOCAL • OFFLINE • YOUR DISK STAYS YOURS" Classes="eyebrow" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="Avalonia 12  ·  .NET 10" Classes="muted" />
    </Grid>
  </Grid>
</Window>
