<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EtchForge.MainWindow"
        Title="EtchForge — 镜像转换"
        Width="1100" Height="650" MinWidth="960" MinHeight="580"
        Background="#FBFCF9" Foreground="#27362B">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#27362B" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#718171" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#627163" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#718F62" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,11" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#476B46" />
      <Setter Property="BorderBrush" Value="#C8D8C1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="15,10" />
    </Style>
    <Style Selector="TextBox.readonly">
      <Setter Property="Background" Value="#F5F8F2" />
      <Setter Property="Foreground" Value="#425942" />
      <Setter Property="BorderBrush" Value="#E2E9DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#789566" />
      <Setter Property="Background" Value="#E8EDE5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,1,*" Margin="30,22,30,26">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,19">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <TextBlock Text="EtchForge" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="/  镜像转换" Classes="detail" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="EngineStatus" Grid.Column="1" Text="检测转换引擎中…"
                 Classes="detail" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Background="#E1E8DD" />

    <Grid Grid.Row="2" ColumnDefinitions="*,1,*,1,*" Margin="0,24,0,0">
      <!-- Input -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,27,0">
        <StackPanel Grid.Row="0" Spacing="0">
          <TextBlock Text="输入镜像" Classes="section" />
          <TextBlock Text="完整的 raw .img 磁盘镜像" Classes="detail" Margin="0,5,0,23" />
          <Button x:Name="ImportButton" Classes="quiet" Content="选择 IMG 文件…"
                  Click="Import_Click" HorizontalAlignment="Stretch" />

          <TextBlock Text="文件" Classes="label" Margin="0,27,0,7" />
          <TextBlock x:Name="SourceName" Text="未选择" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="SourceSummary" Text="大小和分区信息将在这里显示" Classes="detail"
                     TextWrapping="Wrap" Margin="0,5,0,0" />

          <TextBlock Text="SHA-256" Classes="label" Margin="0,26,0,7" />
          <TextBox x:Name="ShaText" Classes="readonly" Text="等待导入" IsReadOnly="True" TextWrapping="Wrap" />
          <TextBlock Text="MD5" Classes="label" Margin="0,16,0,7" />
          <TextBox x:Name="Md5Text" Classes="readonly" Text="等待导入" IsReadOnly="True" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <TextBlock x:Name="ImportStatus" Text="准备就绪" Classes="detail" TextWrapping="Wrap" />
          <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Value="0" Height="4" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="1" Background="#E4EAE0" />

      <!-- Format and progress -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="27,0">
        <StackPanel Grid.Row="0" Spacing="0">
          <TextBlock Text="输出格式" Classes="section" />
          <TextBlock Text="在本机转换，不连接虚拟机平台" Classes="detail" Margin="0,5,0,23" />
          <ComboBox x:Name="FormatPicker" MinHeight="44" HorizontalAlignment="Stretch"
                    Background="#FFFFFF" Foreground="#27362B" SelectionChanged="Format_Changed">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="1">
                  <TextBlock Text="{Binding Name}" Foreground="#27362B" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Foreground="#718171" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="FormatDescription" Text="请选择输出格式" Classes="detail"
                     TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ConversionStatus" Text="等待开始" Classes="detail"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="0%" FontSize="17"
                       FontWeight="SemiBold" Foreground="#5D7C50" />
          </Grid>
          <ProgressBar x:Name="ConversionProgress" Minimum="0" Maximum="100" Value="0" Height="5" />
          <Button x:Name="ConvertButton" Classes="action" Content="开始转换" Click="Convert_Click"
                  HorizontalAlignment="Stretch" IsEnabled="False" Margin="0,14,0,0" />
          <Button x:Name="CancelButton" Classes="quiet" Content="取消转换" Click="Cancel_Click"
                  HorizontalAlignment="Stretch" IsVisible="False" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="3" Background="#E4EAE0" />

      <!-- Output -->
      <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto" Margin="27,0,0,0">
        <StackPanel Grid.Row="0" Spacing="0">
          <TextBlock Text="保存位置" Classes="section" />
          <TextBlock Text="查看转换后的文件" Classes="detail" Margin="0,5,0,23" />
          <Button Classes="quiet" Content="选择文件夹…" Click="Output_Click"
                  HorizontalAlignment="Stretch" />

          <TextBlock Text="输出目录" Classes="label" Margin="0,27,0,7" />
          <TextBlock x:Name="OutputDirectoryText" Text="导入后建议位置" FontSize="13" TextWrapping="Wrap" />

          <TextBlock Text="产物路径" Classes="label" Margin="0,27,0,7" />
          <TextBox x:Name="OutputPreview" Classes="readonly" Text="等待选择镜像和格式"
                   IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" />
          <TextBlock Text="多分卷 VMDK 会生成多个文件。" Classes="detail"
                     TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
        <Button x:Name="OpenOutputButton" Grid.Row="2" Classes="quiet" Content="打开输出文件夹"
                Click="OpenOutput_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
      </Grid>
    </Grid>
  </Grid>
</Window>
