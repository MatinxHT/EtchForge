<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EtchForge.MainWindow"
        Title="EtchForge"
        Icon="avares://EtchForge/Assets/etchforge.png"
        Width="1260" Height="540" MinWidth="1260" MinHeight="540" MaxWidth="1260" MaxHeight="540"
        CanResize="False" Background="#F9FAF6" Foreground="#27372B">
  <Window.Styles>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#748272" />
    </Style>
    <Style Selector="Button.main">
      <Setter Property="Background" Value="#6F9062" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="19,11" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#55794F" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,4" />
    </Style>
    <Style Selector="TextBox.value">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#536852" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#739365" />
      <Setter Property="Background" Value="#E4EADF" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="40,25,40,18">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*">
      <TextBlock Grid.Column="1" Text="EtchForge" FontSize="21" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <Button x:Name="SettingsButton" Grid.Column="2" Classes="link" Content="⚙"
              Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding SettingsToolTip}"
              FontSize="23" Width="36" Height="34"
              HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="250,100,250,100,250" RowDefinitions="85,60,245"
          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5">
      <!-- One horizontal action path, following the reference's visual rhythm. -->
      <Border Grid.Column="0" Grid.Row="0" Width="58" Height="58" CornerRadius="29"
              Background="#6F9062" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="+" Foreground="White" FontSize="34" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border Grid.Column="1" Grid.Row="0" Height="1" Background="#CBD8C5" VerticalAlignment="Center" />
      <Border Grid.Column="2" Grid.Row="0" Width="58" Height="58" CornerRadius="29"
              Background="#E5ECDF" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="⇄" Foreground="#77916D" FontSize="27"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border Grid.Column="3" Grid.Row="0" Height="1" Background="#CBD8C5" VerticalAlignment="Center" />
      <Border Grid.Column="4" Grid.Row="0" Width="58" Height="58" CornerRadius="29"
              Background="#E5ECDF" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="✓" Foreground="#77916D" FontSize="27"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Button x:Name="ImportButton" Grid.Column="0" Grid.Row="1" Classes="main"
              Content="{Binding ImportLabel}" Command="{Binding ImportCommand}"
              IsEnabled="{Binding ImportEnabled}" Width="220" Height="44"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ComboBox x:Name="FormatPicker" Grid.Column="2" Grid.Row="1" Width="220" Height="44"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFFFFF" Foreground="#27372B"
                ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" Foreground="#27372B" FontSize="13" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="OpenOutputButton" Grid.Column="4" Grid.Row="1" Classes="main"
              Content="{Binding OpenFolderLabel}" Command="{Binding OpenFolderCommand}"
              IsEnabled="{Binding OpenFolderEnabled}" Width="220" Height="44"
              HorizontalAlignment="Center" VerticalAlignment="Center" />

      <StackPanel Grid.Column="0" Grid.Row="2" Width="235" Spacing="5" HorizontalAlignment="Center">
        <StackPanel x:Name="SourceDetails" Spacing="3" IsVisible="{Binding SourceDetailsVisible}">
          <TextBlock x:Name="SourceName" Text="{Binding SourceName}" FontSize="13" FontWeight="SemiBold"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SourceSummary" Text="{Binding SourceSummary}" Classes="note" TextAlignment="Center"
                     TextWrapping="Wrap" MaxHeight="34" />
          <Button x:Name="DetailsButton" Classes="link" Content="{Binding DetailsLabel}"
                  Command="{Binding ShowDetailsCommand}" IsEnabled="{Binding DetailsEnabled}"
                  HorizontalAlignment="Center" FontSize="11" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Text="SHA-256" Classes="note" VerticalAlignment="Center" />
            <Button x:Name="CopyShaButton" Grid.Column="1" Classes="link" Content="{Binding CopyShaLabel}"
                    Command="{Binding CopyShaCommand}" IsEnabled="{Binding CopyShaEnabled}" FontSize="11" />
          </Grid>
          <TextBox x:Name="ShaText" Classes="value" Text="{Binding ShaText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
            <TextBlock Text="MD5" Classes="note" VerticalAlignment="Center" />
            <Button x:Name="CopyMd5Button" Grid.Column="1" Classes="link" Content="{Binding CopyMd5Label}"
                    Command="{Binding CopyMd5Command}" IsEnabled="{Binding CopyMd5Enabled}" FontSize="11" />
          </Grid>
          <TextBox x:Name="Md5Text" Classes="value" Text="{Binding Md5Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="ImportFeedback" Spacing="5" IsVisible="{Binding ImportFeedbackVisible}" Margin="0,4,0,0">
          <TextBlock x:Name="ImportStatus" Text="{Binding ImportStatus}" Classes="note" TextAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Value="{Binding ImportProgressValue}" Height="4" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Grid.Row="2" Width="235" Spacing="6" HorizontalAlignment="Center">
        <TextBlock x:Name="FormatDescription" Text="{Binding FormatDescription}" Classes="note" TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Name="ConvertButton" Classes="main" Content="{Binding ConvertLabel}" Command="{Binding ConvertCommand}"
                IsEnabled="{Binding ConvertEnabled}" Width="220" Height="42" HorizontalAlignment="Center" Margin="0,7,0,0" />
        <Button x:Name="ChooseFolderButton" Classes="link" Content="{Binding ChooseFolderLabel}"
                Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding ChooseFolderEnabled}" HorizontalAlignment="Center" />
        <TextBlock x:Name="OutputDirectoryText" Text="{Binding OutputDirectoryText}"
                   ToolTip.Tip="{Binding OutputDirectoryToolTip}" Classes="note"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBox x:Name="OutputPreview" Classes="value" Text="{Binding OutputPreview, Mode=OneWay}"
                 ToolTip.Tip="{Binding OutputPreviewToolTip}"
                 IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="43" />
        <StackPanel x:Name="ConversionPanel" Spacing="6" IsVisible="{Binding ConversionPanelVisible}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ConversionStatus" Text="{Binding ConversionStatus}" Classes="note" TextWrapping="Wrap" />
            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="{Binding ProgressPercent}" Classes="note"
                       Foreground="#55794F" Margin="5,0,0,0" />
          </Grid>
          <ProgressBar x:Name="ConversionProgress" Minimum="0" Maximum="100" Value="{Binding ConversionProgressValue}" Height="5" />
          <Button x:Name="CancelButton" Classes="link" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                  HorizontalAlignment="Center" IsVisible="{Binding CancelVisible}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="4" Grid.Row="2" Width="235" Spacing="7" HorizontalAlignment="Center">
        <TextBlock x:Name="ResultHint" Text="{Binding ResultHint}" IsVisible="{Binding ResultHintVisible}" Classes="note"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <StackPanel x:Name="ResultPanel" Spacing="4" IsVisible="{Binding ResultPanelVisible}">
          <TextBlock x:Name="ElapsedLabel" Text="{Binding ElapsedLabel}" Classes="note" />
          <TextBlock x:Name="ResultElapsedText" Text="{Binding ResultElapsedText}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="ProductsLabel" Text="{Binding ProductsLabel}" Classes="note" Margin="0,8,0,0" />
          <TextBlock x:Name="ResultInfoText" Text="{Binding ResultInfoText}" FontSize="12" />
          <TextBox x:Name="ResultFilesText" Classes="value" Text="{Binding ResultFilesText, Mode=OneWay}" IsReadOnly="True"
                   TextWrapping="Wrap" MaxHeight="92" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="FooterText" Grid.Row="2" Text="{Binding FooterText}"
               Classes="note" HorizontalAlignment="Center" />
  </Grid>
</Window>
